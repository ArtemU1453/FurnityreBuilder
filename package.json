{
  "name": "furniture-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Free online constructor for cabinet furniture: dimensions, sections, parts list and manufacturing data. No account, local-first.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:assumptions": "node scripts/check-assumptions.mjs",
    "check:brand": "node scripts/check-brand-independence.mjs",
    "verify": "npm run check:assumptions && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:brand"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "idb": "^8.0.3",
    "immer": "^10.1.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "exceljs": "^4.4.0",
    "fake-indexeddb": "^6.0.1",
    "fast-check": "^4.9.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
